    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "meshoptimizer": "^1.2.0",
    "obj2gltf": "^3.2.0",
    "oxlint": "^1.85.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.8",
